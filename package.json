{"name":"quaxis-clarus-token","version":"1.0.0","description":"Clarus ($CLA) token for Quaxis: ERC20 + Permit, vesting contracts, Hardhat, tests, CI, Pages, Prettier, Solhint.","license":"MIT","private":true,"scripts":{"clean":"rimraf cache artifacts typechain-types","build":"hardhat compile","test":"hardhat test","coverage":"hardhat coverage","lint":"npm run lint:format && npm run lint:sol","format":"prettier --write .","lint:format":"prettier --check .","lint:sol":"solhint 'contracts/**/*.sol'","deploy":"hardhat run scripts/deploy.ts --network bsc","verify":"hardhat run scripts/verify.ts","vesting":"hardhat run scripts/vesting.ts --network bsc","show:address":"ts-node scripts/show-address.ts"},"devDependencies":{"@nomicfoundation/hardhat-toolbox":"^5.0.0","@typechain/ethers-v6":"^0.5.1","@types/chai":"^4.3.11","@types/mocha":"^10.0.6","@types/node":"^20.14.2","dotenv":"^16.4.5","hardhat":"^2.22.7","hardhat-gas-reporter":"^2.2.0","prettier":"^3.3.3","prettier-plugin-solidity":"^1.3.1","rimraf":"^6.0.1","solhint":"^4.5.3","solhint-config-standard":"^3.4.1","solidity-coverage":"^0.8.12","ts-node":"^10.9.2","typechain":"^8.3.2","typescript":"^5.5.4"},"dependencies":{"@openzeppelin/contracts":"^5.0.2","ethers":"^6.13.2"}}
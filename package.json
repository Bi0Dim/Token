{
  "name": "@quaxis/clarus-token",
  "version": "1.0.0",
  "description": "Quaxis Clarus ($CLA) Token - ERC20 token on BNB Smart Chain with vesting capabilities",
  "main": "index.js",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network bsc",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network bsc",
    "verify:testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "vesting:deploy": "hardhat run scripts/vesting.ts",
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "lint:sol": "solhint 'contracts/**/*.sol'"
  },
  "keywords": [
    "token",
    "erc20",
    "bsc",
    "vesting",
    "clarus",
    "quaxis"
  ],
  "author": "Quaxis",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "solc": "^0.8.24",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
